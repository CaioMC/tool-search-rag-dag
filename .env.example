# Configuração local da POC.
#   1. cp .env.example .env
#   2. Preencha OPENAI_API_KEY com a sua chave: https://platform.openai.com/api-keys
#   3. Pronto: ./toolsearch agente "Emita a nota fiscal do pedido de venda 42"
#
# O .env está no .gitignore: a sua chave nunca vai para o repositório.
# Variáveis exportadas no terminal têm prioridade sobre este arquivo.

OPENAI_API_KEY=

# Opcionais (vazio ou comentado = padrão).
# Servidor compatível com a API da OpenAI (proxy LiteLLM, Azure, gateway da empresa...).
# OPENAI_BASE_URL=https://api.openai.com/v1
# Precisa de gpt-5.4 ou mais novo para os modos com tool search (hosted e client).
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TIMEOUT_SECONDS=120
# TOOLSEARCH_CATALOG=catalog/exemplos/catalogo-mini.json
